# Frontend (Vercel) - Set in Vercel Dashboard
VITE_API_URL=https://your-render-backend.onrender.com
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_CALENDAR_ID=your-calendar-id@gmail.com
VITE_CALENDAR_API=your-google-api-key

# Backend (Render) - Set in Render Dashboard
NODE_ENV=production
PORT=10000
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
FRONTEND_URL=https://your-vercel-app.vercel.app

# Local Development
# Copy to frontend/.env and backend/.env for local dev
# VITE_API_URL=http://localhost:3000
# VITE_GOOGLE_API_KEY=your-google-api-key
# VITE_CALENDAR_ID=your-calendar-id@gmail.com
# VITE_CALENDAR_API=your-google-api-key
# NODE_ENV=development
# PORT=3000
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-gmail-app-password
# FRONTEND_URL=http://localhost:5173